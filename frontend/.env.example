# Copier vers .env et remplir (le fichier .env n’est pas versionné).

# API backend en local (uvicorn, etc.)
VITE_API_URL=http://localhost:8000

# Console DevTools : traces détaillées (login, company switcher, etc.). Laisser vide = calme.
# VITE_APP_DEBUG=1

# Supabase (clés du projet — pas les secrets GitHub du backend)
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Build Docker / CI / prod : définir VITE_API_URL sur GitHub
# (Settings → Secrets and variables → Actions → Variables → VITE_API_URL)
# avec l’URL HTTPS publique du backend (ex. Cloud Run), utilisée par deploy.yml.
