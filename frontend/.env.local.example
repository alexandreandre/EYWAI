# Environnement frontend pour developpement local.
# Copier vers frontend/.env.local.

VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=http://127.0.0.1:54321

# Remplir avec la valeur affichee par `make supabase-status-env`
# apres `make supabase-start`.
VITE_SUPABASE_PUBLISHABLE_KEY=<local-anon-key>
VITE_SUPABASE_PROJECT_ID=eywai-local

VITE_APP_DEBUG=1
