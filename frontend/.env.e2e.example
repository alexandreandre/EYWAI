# Identifiants du compte QA pour les tests E2E Playwright (environnement de TEST).
# Copier vers frontend/.env.e2e (gitignoré) et remplir.
# Le compte se crée avec scripts/qa/seed_qa_user.sql — voir docs/qa/strategie-qa.md.
E2E_QA_EMAIL=qa.playwright@eywai.access.local
E2E_QA_PASSWORD=

# Surcharges optionnelles (par défaut : environnement de test Cloud Run).
# E2E_BASE_URL=http://localhost:5173
# E2E_API_URL=http://localhost:8000
