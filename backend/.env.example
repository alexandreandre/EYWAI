# --- Supabase (requis) ---
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_KEY=votre-cle-anon-ou-api

# Admin / bypass RLS (recommandé en dev, au moins une des deux)
# SUPABASE_SERVICE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

