# Copier vers .env et remplir (le fichier .env n'est pas versionné).
# cp .env.example .env

# --- Supabase (requis) ---
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_KEY=votre-cle-anon-ou-api

# Admin / bypass RLS (recommandé en dev, au moins une des deux)
# SUPABASE_SERVICE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- IA / Copilot (optionnel) ---
# OPENROUTER_API_KEY=
# OPENROUTER_HTTP_REFERER=https://eywai.app
# OPENROUTER_APP_TITLE=EYWAI

# --- Scraping (optionnel) ---
# Agent autonome de réparation de code : désactivé par défaut.
# Pour réactiver (expérimental) : EYWAI_REPAIR_AGENT_ENABLED=1
# EYWAI_PARSER_REPAIR_DISABLED=1  # désactive aussi la réparation parser supervisée (cas B)

# --- Légifrance / KALI via PISTE (import conventions collectives) ---
# Inscription : https://piste.gouv.fr — créer une application API Légifrance
# PISTE_CLIENT_ID=
# PISTE_CLIENT_SECRET=
# PISTE_SANDBOX=true

# --- Application ---
FRONTEND_URL=http://localhost:8080
# LOG_LEVEL=INFO

# --- CORS (prod / preview ; optionnel en local) ---
# CORS_ALLOW_ORIGIN_REGEX=

# --- Workers Dramatiq (optionnel) ---
# REDIS_URL=redis://localhost:6379/0

# --- E-mails transactionnels (repli si config admin inactive) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USER=
# SMTP_PASSWORD=
# FROM_EMAIL=
# FROM_NAME=EYWAI
# REPLY_TO=
# SUPPORT_RECIPIENTS=contact@eywai.fr
# Redirection temporaire des e-mails « nouveau bulletin » (vide = envoi au salarié).
# PAYSLIP_EMAIL_REDIRECT=eywaitest@gmail.com
# Redirection forcée de TOUS les e-mails sortants (prod temporaire / env de test).
# EMAIL_FORCE_REDIRECT_TO=eywaitest@gmail.com

# --- YouSign (optionnel) ---
# YOUSIGN_API_KEY=
# YOUSIGN_BASE_URL=https://api.yousign.app/v3
# YOUSIGN_WEBHOOK_SECRET=

# --- Net-entreprises / Télétransmission DSN (optionnel) ---
# Laisser false tant que la connexion API n'est pas branchée : seul le dépôt manuel
# sur net-entreprises.fr est alors proposé (aucun appel réseau).
# NET_ENTREPRISES_ENABLED=false
