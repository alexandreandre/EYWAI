# Environnement backend de production.
# Ne jamais commiter le vrai backend/.env.

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<prod-anon-or-publishable-key>
SUPABASE_SERVICE_KEY=<prod-service-role-key>
SUPABASE_SERVICE_ROLE_KEY=<prod-service-role-key>

FRONTEND_URL=https://<frontend-prod-domain>
LOG_LEVEL=WARNING

NET_ENTREPRISES_ENABLED=false
ACCOUNTING_API_ENABLED=false
