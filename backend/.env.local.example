# Environnement backend pour Supabase local.
# Copier vers backend/.env quand vous voulez travailler en local.

SUPABASE_URL=http://127.0.0.1:54321

# Remplir avec les valeurs affichees par `make supabase-status-env`
# apres `make supabase-start`.
SUPABASE_KEY=<local-anon-key>
SUPABASE_SERVICE_KEY=<local-service-role-key>
SUPABASE_SERVICE_ROLE_KEY=<local-service-role-key>

FRONTEND_URL=http://localhost:8080
LOG_LEVEL=INFO

# Services externes désactivés par défaut en local.
NET_ENTREPRISES_ENABLED=false
ACCOUNTING_API_ENABLED=false
EYWAI_REPAIR_AGENT_ENABLED=0
